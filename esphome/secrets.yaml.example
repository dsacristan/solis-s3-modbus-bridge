# Copia este fichero a `secrets.yaml` y rellena TUS datos.
# (`secrets.yaml` está en .gitignore: nunca se sube.)
#
# Solo hace falta si vas a compilar el firmware ESPHome de referencia (carpeta esphome/).
# El puente propio (src/) NO usa fichero de secretos: su WiFi se configura por el
# portal cautivo en modo AP (ver README).

wifi_ssid: "TU_SSID"
wifi_password: "TU_PASSWORD_WIFI"

wifi_ap_ssid: "Solis S3 Setup"
wifi_ap_password: "clave-de-al-menos-8-caracteres"

# Clave de cifrado de la API nativa de ESPHome (base64 de 32 bytes):
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "RELLENA_CON_TU_CLAVE_BASE64"

# Contraseña de la OTA de ESPHome
ota_password: "TU_OTA_PASSWORD"
